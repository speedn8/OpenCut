{
  "name": "@opencut/studio",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Local desktop editing workspace derived from OpenCut Classic",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 38841",
    "build": "node scripts/licenses.mjs && vite build",
    "check": "tsc --noEmit",
    "test": "bun test ./src ./tests",
    "start": "electron .",
    "desktop:pack": "bun run build && electron-builder --win --dir",
    "desktop:dist": "bun run build && electron-builder --win portable"
  },
  "dependencies": {},
  "devDependencies": {
    "@hello-pangea/dnd": "18.0.1",
    "@hugeicons/core-free-icons": "3.3.0",
    "@hugeicons/react": "1.1.6",
    "@napi-rs/canvas": "1.0.12",
    "@playwright/test": "1.56.1",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-primitive": "2.1.4",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tailwindcss/typography": "0.5.19",
    "@tailwindcss/vite": "4.2.1",
    "@types/culori": "4.0.1",
    "@types/node": "24.2.1",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "culori": "4.0.2",
    "electron": "44.9.2",
    "electron-builder": "26.15.3",
    "embla-carousel-react": "8.6.0",
    "eventemitter3": "5.0.4",
    "feed": "5.2.1",
    "input-otp": "1.4.2",
    "lucide-react": "0.562.0",
    "mediabunny": "1.41.0",
    "motion": "12.38.0",
    "nanoid": "5.1.9",
    "next-themes": "0.4.6",
    "opencut-wasm": "0.2.10",
    "radix-ui": "1.4.3",
    "react": "19.2.5",
    "react-day-picker": "8.10.1",
    "react-dom": "19.2.5",
    "react-hook-form": "7.74.0",
    "react-icons": "5.6.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "2.1.9",
    "react-window": "2.2.7",
    "rehype-autolink-headings": "7.1.0",
    "rehype-parse": "9.0.1",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "sonner": "1.7.4",
    "soundtouchjs": "0.3.0",
    "tailwind-merge": "3.5.0",
    "tailwindcss-animate": "1.0.7",
    "typescript": "6.0.2",
    "unified": "11.0.5",
    "use-deep-compare-effect": "1.8.1",
    "vite": "8.0.0",
    "vite-plugin-wasm": "3.6.0",
    "wavesurfer.js": "7.12.6",
    "zod": "4.3.6",
    "zustand": "5.0.12"
  },
  "build": {
    "appId": "app.opencut.studio.local",
    "productName": "OpenCut Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "LICENSE-CLASSIC",
      "THIRD_PARTY_NOTICES.md",
      "THIRD_PARTY_LICENSES.txt"
    ],
    "asar": true,
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "OpenCut-Studio-${version}-Windows.${ext}",
      "signAndEditExecutable": false
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  },
  "trustedDependencies": [
    "electron",
    "esbuild",
    "@tailwindcss/oxide"
  ]
}
